<!--
  Reference only -- this is infrastructure config, not SQL DDL.
  Deploy identically to config.d/ on every node in FRA, MUC, and HAM
  (e.g. via ConfigMap + volume mount on the official ClickHouse operator's
  ClickHouseCluster podTemplate/containerTemplate). In the kind demo this same
  shape is injected as spec.settings.extraConfig by scripts/patch-federation.sh
  (plaintext) and scripts/setup-tls.sh (TLS); see those for the live values.

  ── Cluster secret (per-user RBAC across DCs) ─────────────────────────────────
  <secret> turns on ClickHouse's secure inter-server protocol for this cluster.
  With it, a cross-DC query propagates the ORIGINAL user to remote shards and
  each shard enforces that user's RBAC. WITHOUT it, the remote subquery runs as
  the `default` user and the initiator's identity is never sent -- trust then
  rests entirely on locking down the inter-server port.
  The secret MUST be byte-identical on every node. Store it in a K8s Secret and
  inject via env (<secret from_env="CH_CLUSTER_SECRET"/>) rather than committing
  a literal; the demo scripts generate one at runtime (see setup.sh).
  Two caveats the secret imposes (see README "Cross-region RBAC"):
    - The propagated user is matched BY NAME, so cross-DC users must exist
      identically on every node (schemas/04_rbac runs per DC); a missing user
      on a remote DC resets the connection (NETWORK_ERROR: Broken pipe).
    - ClickHouse propagates the user identity but does NOT enable its ROLES on
      remote shards -- only privileges granted DIRECTLY to the user are enforced
      remotely. Grant cross-DC readers directly on the user, not via a role.

  Shard order matters: shard_num is 1-based, so
    shard 1 = FRA, shard 2 = MUC, shard 3 = HAM.
  Each shard carries a <name> (FRA/MUC/HAM). This surfaces as
  system.clusters.shard_name, which the default.regionToShard dictionary reads
  to build the region -> (shard_num - 1) sharding-key map used by
  otel_global. The <name> values MUST match the region column values.
-->
<clickhouse>
  <remote_servers>
    <global>
      <!-- Propagate the querying user + grants to remote shards; inject the
           same value on every node (from_env from a K8s Secret in production). -->
      <secret from_env="CH_CLUSTER_SECRET"/>
      <shard>
        <name>FRA</name>
        <replica><host>fra-ch-0.fra.example.com</host><port>9440</port><secure>1</secure></replica>
        <replica><host>fra-ch-1.fra.example.com</host><port>9440</port><secure>1</secure></replica>
      </shard>
      <shard>
        <name>MUC</name>
        <replica><host>muc-ch-0.muc.example.com</host><port>9440</port><secure>1</secure></replica>
        <replica><host>muc-ch-1.muc.example.com</host><port>9440</port><secure>1</secure></replica>
      </shard>
      <shard>
        <name>HAM</name>
        <replica><host>ham-ch-0.ham.example.com</host><port>9440</port><secure>1</secure></replica>
        <replica><host>ham-ch-1.ham.example.com</host><port>9440</port><secure>1</secure></replica>
      </shard>
    </global>
  </remote_servers>
</clickhouse>
